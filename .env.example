# Copy to .env to override. The stack boots fine with no .env at all --
# these are the same values baked in as defaults in config.py.

# --- Ollama ---------------------------------------------------------------
# Left unset on purpose: each profile picks the right address by itself, and a
# value here would override it. The defaults are:
# OLLAMA_HOST=http://ollama:11434                 # cpu/gpu profiles
# OLLAMA_HOST=http://host.docker.internal:11434   # external profile (macOS, or any native Ollama)

# --- Models ---------------------------------------------------------------
# Default targets a 16GB laptop. On an 8GB machine use gemma3:1b-it-qat.
MODEL_MAIN=gemma4:e2b-it-qat
MODEL_EMBED=embeddinggemma-2:270m

# --- Chroma ---------------------------------------------------------------
CHROMA_HOST=chroma
CHROMA_PORT=8000

# --- SEC filings (Embedding search page) ----------------------------------
# Required to fetch filings: the SEC asks automated clients to declare who they
# are. Use your own name and a real address. Searching what is already indexed
# works without it.
SEC_USER_AGENT="Your Name you@example.com"
SEC_COLLECTION=sec_filings
EMBED_BATCH_SIZE=16

# --- Agent page -----------------------------------------------------------
# If tool calling is unreliable on E2B: `make pull-e4b`, then gemma4:e4b-it-qat.
AGENT_MODEL=gemma4:e2b-it-qat
AGENT_MAX_TURNS=6
TRADE_MAX_PCT=5

# --- Published host ports -------------------------------------------------
# Only affect what is reachable from the host; the app talks to Chroma over the
# compose network on CHROMA_PORT above. 8000 is heavily contested on dev
# machines, hence the 8100 default.
APP_PUBLISHED_PORT=8501
CHROMA_PUBLISHED_PORT=8100
OLLAMA_PUBLISHED_PORT=11434

# --- Inference tuning -----------------------------------------------------
OLLAMA_NUM_CTX=8192
OLLAMA_KEEP_ALIVE=-1
TEMPERATURE=0.0
SEED=7
